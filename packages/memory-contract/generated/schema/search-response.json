{
  "$id": "https://hybrid-mind.local/schema/search-response.json",
  "title": "search-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "type": "string"
    },
    "principalId": {
      "type": "string",
      "minLength": 1
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "revisionId": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "sourceTitle": {
            "type": "string"
          },
          "sourceKind": {
            "type": "string"
          },
          "locator": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "page"
                  },
                  "page": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "region": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "w": {
                        "type": "number"
                      },
                      "h": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "w",
                      "h"
                    ]
                  }
                },
                "required": [
                  "type",
                  "page"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "span"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "quote": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "start",
                  "end",
                  "quote"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "row"
                  },
                  "row": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "column": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "row"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "time"
                  },
                  "startSeconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "endSeconds": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "type",
                  "startSeconds",
                  "endSeconds"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "image-region"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  }
                },
                "required": [
                  "type",
                  "x",
                  "y",
                  "w",
                  "h"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "whole"
                  }
                },
                "required": [
                  "type"
                ]
              }
            ]
          },
          "locatorText": {
            "type": "string"
          },
          "contextPrefix": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "signals": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "lexical",
                "vector"
              ]
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "anchorIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "caseIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "revisionId",
          "sourceId",
          "sourceTitle",
          "sourceKind",
          "locator",
          "locatorText",
          "contextPrefix",
          "text",
          "score",
          "signals",
          "anchorIds",
          "claimIds",
          "caseIds"
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "recordVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "accessScope": {
            "type": "string",
            "enum": [
              "standard",
              "restricted"
            ]
          },
          "evidenceClass": {
            "type": "string",
            "enum": [
              "documented",
              "field-verified",
              "inferred",
              "illustrative",
              "proposed",
              "unknown"
            ]
          },
          "reviewState": {
            "type": "string",
            "enum": [
              "unreviewed",
              "accepted",
              "rejected",
              "superseded"
            ]
          },
          "reviewedBy": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "effectiveFrom": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "effectiveTo": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "subjectId": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string"
          },
          "object": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "entity"
                  },
                  "entityId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "entityId"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "value"
                  },
                  "value": {
                    "type": "string"
                  },
                  "unit": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "type",
                  "value",
                  "unit"
                ]
              }
            ]
          },
          "anchors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "anchorId": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "supporting",
                    "conflicting",
                    "contextual",
                    "superseding"
                  ]
                }
              },
              "required": [
                "anchorId",
                "role"
              ]
            }
          },
          "episodeId": {
            "type": "string",
            "minLength": 1
          },
          "supersedesClaimId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "invalidatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "recordVersion",
          "accessScope",
          "evidenceClass",
          "reviewState",
          "reviewedBy",
          "reviewedAt",
          "effectiveFrom",
          "effectiveTo",
          "subjectId",
          "relation",
          "object",
          "anchors",
          "episodeId",
          "supersedesClaimId",
          "invalidatedAt"
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claimId": {
            "type": "string",
            "minLength": 1
          },
          "conflictsWith": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "claimId",
          "conflictsWith"
        ]
      }
    },
    "signalsRun": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "lexical",
          "vector"
        ]
      }
    }
  },
  "required": [
    "query",
    "principalId",
    "hits",
    "claims",
    "conflicts",
    "signalsRun"
  ]
}
