{
  "$id": "https://hybrid-mind.local/schema/claim.json",
  "title": "claim",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "recordVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "accessScope": {
      "type": "string",
      "enum": [
        "standard",
        "restricted"
      ]
    },
    "evidenceClass": {
      "type": "string",
      "enum": [
        "documented",
        "field-verified",
        "inferred",
        "illustrative",
        "proposed",
        "unknown"
      ]
    },
    "reviewState": {
      "type": "string",
      "enum": [
        "unreviewed",
        "accepted",
        "rejected",
        "superseded"
      ]
    },
    "reviewedBy": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "effectiveFrom": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "effectiveTo": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "subjectId": {
      "type": "string",
      "minLength": 1
    },
    "relation": {
      "type": "string"
    },
    "object": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "entity"
            },
            "entityId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "entityId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "value"
            },
            "value": {
              "type": "string"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "value",
            "unit"
          ],
          "additionalProperties": false
        }
      ]
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "anchorId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "supporting",
              "conflicting",
              "contextual",
              "superseding"
            ]
          }
        },
        "required": [
          "anchorId",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "episodeId": {
      "type": "string",
      "minLength": 1
    },
    "supersedesClaimId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "invalidatedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "recordVersion",
    "accessScope",
    "evidenceClass",
    "reviewState",
    "reviewedBy",
    "reviewedAt",
    "effectiveFrom",
    "effectiveTo",
    "subjectId",
    "relation",
    "object",
    "anchors",
    "episodeId",
    "supersedesClaimId",
    "invalidatedAt"
  ],
  "additionalProperties": false
}
