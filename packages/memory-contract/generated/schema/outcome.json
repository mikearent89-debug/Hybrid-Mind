{
  "$id": "https://hybrid-mind.local/schema/outcome.json",
  "title": "outcome",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "recordVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "accessScope": {
      "type": "string",
      "enum": [
        "standard",
        "restricted"
      ]
    },
    "evidenceClass": {
      "type": "string",
      "enum": [
        "documented",
        "field-verified",
        "inferred",
        "illustrative",
        "proposed",
        "unknown"
      ]
    },
    "reviewState": {
      "type": "string",
      "enum": [
        "unreviewed",
        "accepted",
        "rejected",
        "superseded"
      ]
    },
    "reviewedBy": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "effectiveFrom": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "effectiveTo": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposalId": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "partial",
        "unknown"
      ]
    },
    "lessonIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recordedBy": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "anchorId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "supporting",
              "conflicting",
              "contextual",
              "superseding"
            ]
          }
        },
        "required": [
          "anchorId",
          "role"
        ]
      }
    }
  },
  "required": [
    "id",
    "recordVersion",
    "accessScope",
    "evidenceClass",
    "reviewState",
    "reviewedBy",
    "reviewedAt",
    "effectiveFrom",
    "effectiveTo",
    "proposalId",
    "description",
    "result",
    "lessonIds",
    "recordedBy",
    "occurredAt",
    "anchors"
  ]
}
