{
  "$id": "https://hybrid-mind.local/schema/proposal-draft.json",
  "title": "proposal-draft",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string"
    },
    "ownerIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targetDates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "label",
          "date"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "costBasis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "anchorId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "description",
          "amount",
          "currency",
          "anchorId"
        ],
        "additionalProperties": false
      }
    },
    "successCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "anchorId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "supporting",
              "conflicting",
              "contextual",
              "superseding"
            ]
          }
        },
        "required": [
          "anchorId",
          "role"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "scope",
    "ownerIds",
    "targetDates",
    "dependencies",
    "costBasis",
    "successCriteria",
    "anchors"
  ],
  "additionalProperties": false
}
