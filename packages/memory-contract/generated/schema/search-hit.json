{
  "$id": "https://hybrid-mind.local/schema/search-hit.json",
  "title": "search-hit",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "revisionId": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "sourceTitle": {
      "type": "string"
    },
    "sourceKind": {
      "type": "string"
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "page"
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "region": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "w": {
                  "type": "number"
                },
                "h": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y",
                "w",
                "h"
              ]
            }
          },
          "required": [
            "type",
            "page"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "span"
            },
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "quote": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "start",
            "end",
            "quote"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "row"
            },
            "row": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "column": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "row"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "time"
            },
            "startSeconds": {
              "type": "number",
              "minimum": 0
            },
            "endSeconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "startSeconds",
            "endSeconds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "image-region"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "x",
            "y",
            "w",
            "h"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "whole"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "locatorText": {
      "type": "string"
    },
    "contextPrefix": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "signals": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "lexical",
          "vector"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "anchorIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claimIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "caseIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "revisionId",
    "sourceId",
    "sourceTitle",
    "sourceKind",
    "locator",
    "locatorText",
    "contextPrefix",
    "text",
    "score",
    "signals",
    "anchorIds",
    "claimIds",
    "caseIds"
  ]
}
