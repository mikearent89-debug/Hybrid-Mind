{
  "$id": "https://hybrid-mind.local/schema/anchor-link.json",
  "title": "anchor-link",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "anchorId": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "supporting",
        "conflicting",
        "contextual",
        "superseding"
      ]
    }
  },
  "required": [
    "anchorId",
    "role"
  ]
}
